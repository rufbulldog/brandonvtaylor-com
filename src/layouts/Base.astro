---
interface Props {
	title: string;
	description: string;
}
import { imageCredits } from "../data/resume";
const { title, description } = Astro.props;
const year = 2026;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://brandonvtaylor.com/" />
		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href="#top">Brandon V. Taylor</a>
				<nav class="nav">
						<a href="/#about">About</a>
						<a href="/#experience">Experience</a>
						<a href="/#projects">Projects</a>
						<a href="/#testimonials">Testimonials</a>
						<a href="/#education">Education</a>
						<a href="/resume">Résumé</a>
					</nav>
			</div>
		</header>

		<main id="top">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<p>© {year} Brandon V. Taylor</p>
				<p class="muted">Designed and built by Brandon · Astro, hosted on AWS Amplify · {year}</p>
			</div>
			<div class="container">
				<details class="credits">
					<summary>Image credits</summary>
					<ul>
						{
							imageCredits.map((c) => (
								<li>
									{c.label} — {c.credit}, Public Domain, via{" "}
									<a href={c.href} target="_blank" rel="noopener">
										Wikimedia Commons
									</a>
								</li>
							))
						}
					</ul>
				</details>
			</div>
		</footer>

		<style is:global>
:root {
				color-scheme: dark;
				--bg:#161f2e; --bg-2:#101826;
				--surface:#1e293b; --surface-2:#243345;
				--fg:#eef2f8; --muted:#9aa7ba;
				--border:rgba(255,255,255,0.12);
				--accent:#7c9cff; --accent-2:#a78bfa;
				--accent-fg:#0b1220;
				--pill-bg:rgba(124,156,255,0.18); --pill-fg:#cdd9ff;
				--shadow:0 1px 2px rgba(0,0,0,0.35), 0 18px 44px -22px rgba(0,0,0,0.55);
				--maxw:64rem;
			}
			.accent-blue{--accent:#38bdf8;--accent-2:#7dd3fc;}
			.accent-violet{--accent:#a78bfa;--accent-2:#c4b5fd;}
			.accent-teal{--accent:#2dd4bf;--accent-2:#5eead4;}
			.accent-amber{--accent:#fbbf24;--accent-2:#fcd34d;}
			.accent-rose{--accent:#fb7185;--accent-2:#fda4af;}
			.accent-osu{--accent:#DC4405;--accent-2:#ff7a3c;}

			* {
				box-sizing: border-box;
			}
			html {
				scroll-behavior: smooth;
			}
			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}
			body {
				margin: 0;
				background:
					radial-gradient(1100px 540px at 12% -8%, rgba(56,189,248,0.16), transparent 60%),
					radial-gradient(900px 480px at 100% 4%, rgba(167,139,250,0.16), transparent 58%),
					var(--bg);
				background-attachment: fixed;
				color: var(--fg);
				font-family:
					-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
					Arial, sans-serif;
				font-size: 17px;
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}

			.container {
				width: 100%;
				max-width: var(--maxw);
				margin-inline: auto;
				padding-inline: 1.5rem;
			}

			a {
				color: var(--accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: 4px;
			}

			/* Header */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 10;
				background: color-mix(in srgb, var(--bg) 85%, transparent);
				backdrop-filter: saturate(160%) blur(10px);
				border-bottom: 1px solid var(--border);
			}
			.header-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				min-height: 56px;
			}
			.brand {
				color: var(--fg);
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			.brand:hover {
				text-decoration: none;
			}
			.nav {
				display: flex;
				gap: 1.25rem;
				flex-wrap: wrap;
			}
			.nav a {
				color: var(--muted);
				font-size: 0.95rem;
			}
			.nav a:hover {
				color: var(--fg);
				text-decoration: none;
			}

			/* Sections */
			section[id] {
				scroll-margin-top: 72px;
			}
			.section {
				position:relative;
				margin-block:1.75rem;
				padding-block:2.5rem;
				background:linear-gradient(180deg, color-mix(in srgb, var(--accent) 10%, var(--surface)), var(--surface) 46%);
				border:1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
				border-radius:18px;
				box-shadow:var(--shadow), 0 26px 60px -36px color-mix(in srgb, var(--accent) 55%, transparent);
			}
			.section::before{
				content:"";
				position:absolute; top:0; left:1.5rem; right:1.5rem; height:3px;
				border-radius:0 0 3px 3px;
				background:linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 0%, transparent));
			}
			.section-title {
				font-size: 0.85rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--accent);
				margin: 0 0 1.75rem;
			}
			.section-lead {
				margin: -1rem 0 2rem;
				color: var(--muted);
				max-width: 42rem;
			}
			.prose {
				max-width: 44rem;
			}
			.prose p {
				margin: 0 0 1rem;
			}
			.muted {
				color: var(--muted);
			}

			/* Hero */
			.hero {
				position:relative;
				margin-top:1.5rem;
				padding-block:4rem 3.25rem;
				border-radius:22px;
				border:1px solid var(--border);
				overflow:hidden;
				background:
					radial-gradient(820px 380px at 0% 0%, rgba(124,156,255,0.28), transparent 60%),
					radial-gradient(680px 340px at 100% 18%, rgba(45,212,191,0.20), transparent 60%),
					linear-gradient(180deg, var(--surface), var(--bg-2));
			}
			.eyebrow {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--muted);
				letter-spacing: 0.01em;
			}
			.hero-name {
				margin:0;
				font-size:clamp(2.5rem, 7vw, 4rem);
				line-height:1.05;
				letter-spacing:-0.03em;
				font-weight:800;
				background:linear-gradient(118deg, var(--fg) 30%, var(--accent-2));
				-webkit-background-clip:text;
				background-clip:text;
				color:transparent;
			}
			.hero-role {
				margin: 0.75rem 0 0;
				font-size: clamp(1.15rem, 3vw, 1.5rem);
				font-weight: 600;
			}
			.hero-blurb {
				margin: 0.5rem 0 0;
				max-width: 38rem;
				font-size: 1.1rem;
				color: var(--muted);
			}
			.hero-cta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.75rem;
			}

			/* Buttons */
			.btn {
				display: inline-block;
				padding: 0.6rem 1.1rem;
				border-radius: 10px;
				border: 1px solid var(--border);
				background: var(--surface);
				color: var(--fg);
				font-weight: 600;
				font-size: 0.95rem;
				transition: transform 0.06s ease, border-color 0.15s ease;
			}
			.btn:hover {
				text-decoration: none;
				border-color: var(--accent);
			}
			.btn:active {
				transform: translateY(1px);
			}
			.btn-primary {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--accent-fg);
			}

			/* Stats */
			.stats {
				list-style: none;
				margin: 2.5rem 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1rem;
			}
			.stats li {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				padding: 1rem 1.1rem;
				background: var(--surface-2);
				border: 1px solid var(--border);
				border-radius: 12px;
			}
			.stat-value {
				font-size: 1.4rem;
				font-weight: 800;
				letter-spacing: -0.02em;
			}
			.stat-label {
				font-size: 0.82rem;
				color: var(--muted);
				line-height: 1.3;
			}

			/* Experience */
			.exp-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}
			.exp-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.exp-title {
				margin: 0;
				font-size: 1.15rem;
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			.exp-company {
				margin: 0.1rem 0 0;
				color: var(--accent);
				font-weight: 600;
				font-size: 0.98rem;
			}
			.exp-period {
				color: var(--muted);
				font-size: 0.9rem;
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.exp-bullets {
				margin: 0.85rem 0 0;
				padding-left: 1.1rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				color: var(--fg);
			}
			.exp-bullets li {
				padding-left: 0.25rem;
			}
			.exp-bullets li::marker {
				color: var(--accent);
			}

			.exp-headings {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}
			.exp-logo {
				display: block;
				height: 48px;
				width: auto;
				max-width: 200px;
				margin: 0 0 0.75rem;
				padding: 9px 14px;
				box-sizing: border-box;
				object-fit: contain;
				background: #ffffff;
				border: 1px solid var(--border);
				border-radius: 10px;
				box-shadow: var(--shadow);
			}
			.exp-details {
				margin-top: 0.85rem;
			}
			.exp-details > summary {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				cursor: pointer;
				list-style: none;
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--accent);
				width: fit-content;
			}
			.exp-details > summary::-webkit-details-marker {
				display: none;
			}
			.exp-details > summary::before {
				content: "\203A";
				display: inline-block;
				transition: transform 0.15s ease;
				font-size: 1.1em;
				line-height: 1;
			}
			.exp-details[open] > summary::before {
				transform: rotate(90deg);
			}
			.exp-details > summary:hover {
				text-decoration: underline;
			}
			.exp-details .exp-details-less {
				display: none;
			}
			.exp-details[open] .exp-details-more {
				display: none;
			}
			.exp-details[open] .exp-details-less {
				display: inline;
			}
			.exp-narrative {
				margin-top: 0.75rem;
				max-width: 44rem;
				color: var(--muted);
			}
			.exp-narrative p {
				margin: 0 0 0.85rem;
			}
			.exp-narrative p:last-child {
				margin-bottom: 0;
			}

			/* Experience: inline video */
			.exp-video {
				margin: 1rem 0 0;
				max-width: 30rem;
			}
			.exp-video-frame {
				position: relative;
				width: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid var(--border);
				background: #000;
			}
			.exp-video-frame iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.exp-video figcaption {
				margin-top: 0.5rem;
				font-size: 0.85rem;
				color: var(--muted);
			}

			/* Experience: inline image */
			.exp-image {
				margin: 1rem 0 0;
				max-width: 24rem;
			}
			.exp-image img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 10px;
				border: 1px solid var(--border);
			}
			.exp-image figcaption {
				margin-top: 0.5rem;
				font-size: 0.85rem;
				color: var(--muted);
			}

			/* Experience: screenshot gallery */
			.exp-gallery {
				margin: 1rem 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.exp-shot {
				margin: 0;
				width: 9rem;
			}
			.exp-shot img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 10px;
				border: 1px solid var(--border);
				background: var(--surface-2);
			}
			.exp-shot figcaption {
				margin-top: 0.4rem;
				font-size: 0.8rem;
				color: var(--muted);
			}

			/* Project links */
			.proj-links {
				display: flex;
				gap: 1rem;
				margin-top: 1rem;
			}
			.proj-links a {
				font-size: 0.86rem;
				font-weight: 600;
			}

			/* Career journey strip */
			.journey {
				list-style: none;
				margin: 0 0 2.5rem;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem 1.75rem;
				align-items: flex-start;
			}
			.journey-item{width:4.5rem;}
			.journey-link{display:flex;flex-direction:column;align-items:center;gap:.4rem;text-align:center;color:inherit;text-decoration:none;transition:transform .12s ease;}
			.journey-link:hover{transform:translateY(-3px);text-decoration:none;}
			.journey-link:hover .journey-logo{border-color:var(--accent);}
			.journey-logo {
				width: 56px;
				height: 56px;
				object-fit: contain;
				padding: 6px;
				border-radius: 10px;
				border: 1px solid var(--border);
				background: #ffffff;
			}
			.journey-label {
				font-size: 0.72rem;
				font-weight: 600;
				color: var(--muted);
				line-height: 1.2;
			}

			/* Project screenshot */
			.proj-shot {
				display: block;
				margin: -0.2rem 0 1rem;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid var(--border);
				background: var(--surface-2);
				line-height: 0;
			}
			.proj-shot img {
				width: 100%;
				height: auto;
				display: block;
			}
			.proj-shot:hover {
				border-color: var(--accent);
			}

			/* Image credits */
			.credits {
				margin: 0 auto 1.5rem;
				font-size: 0.8rem;
				color: var(--muted);
			}
			.credits > summary {
				cursor: pointer;
				width: fit-content;
			}
			.credits ul {
				margin: 0.6rem 0 0;
				padding-left: 1.1rem;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}

			/* Project phone screenshots */
			.proj-screens {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin: -0.2rem 0 1rem;
			}
			.proj-screen {
				margin: 0;
				flex: 1 1 0;
				min-width: 0;
			}
			.proj-screen img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 8px;
				border: 1px solid var(--border);
				background: var(--surface-2);
			}
			.proj-screen figcaption {
				margin-top: 0.3rem;
				font-size: 0.74rem;
				color: var(--muted);
				text-align: center;
			}

			/* Footer social */
			.footer-social {
				display: flex;
				gap: 1rem;
			}
			.footer-social a {
				color: var(--muted);
			}
			.footer-social a:hover {
				color: var(--fg);
			}

			/* Projects */
			.proj-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
				gap: 1.1rem;
			}
			.proj-card {
				display: flex;
				flex-direction: column;
				padding: 1.4rem;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 14px;
				box-shadow: var(--shadow);
			}
			.proj-card-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 0.5rem;
			}
			.proj-name {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 700;
			}
			.proj-year {
				color: var(--muted);
				font-size: 0.82rem;
				white-space: nowrap;
			}
			.proj-blurb {
				margin: 0.6rem 0 1.1rem;
				color: var(--muted);
				font-size: 0.96rem;
			}
			.proj-tags {
				list-style: none;
				margin: auto 0 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.proj-tags li {
				font-size: 0.76rem;
				font-weight: 600;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				background: var(--pill-bg);
				color: var(--pill-fg);
			}

			/* Footer */
			.site-footer {
				border-top: 1px solid var(--border);
				margin-top: 1rem;
			}
			.footer-inner {
				display: flex;
				justify-content: space-between;
				gap: 0.5rem;
				flex-wrap: wrap;
				padding-block: 2rem;
				font-size: 0.9rem;
				color: var(--muted);
			}
			.footer-inner p {
				margin: 0;
			}

			@media (max-width: 640px) {
				.stats {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.nav {
					gap: 0.9rem;
				}
			}

			/* Testimonials */
			.quotes{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr));gap:1.1rem;}
			.quote{position:relative;display:flex;flex-direction:column;padding:1.4rem;background:color-mix(in srgb, var(--accent) 8%, var(--surface));border:1px solid color-mix(in srgb, var(--accent) 28%, var(--border));border-radius:14px;}
			.quote-mark{font-family:Georgia,serif;font-size:2.4rem;line-height:.6;color:var(--accent);opacity:.6;}
			.quote-text{margin:.4rem 0 1rem;color:var(--fg);font-size:.97rem;}
			.quote-meta{margin-top:auto;}
			.quote-name{font-weight:700;font-size:.92rem;}
			.quote-role{color:var(--muted);font-size:.82rem;}
			/* Resume page */
			.resume-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:1.25rem 0 0;}
			.rsm{max-width:48rem;}
			.rsm h2{font-size:1.05rem;margin:1.8rem 0 .6rem;color:var(--accent);}
			.rsm .role{margin:0 0 1.2rem;}
			.rsm .role h3{margin:0;font-size:1.02rem;}
			.rsm .role .meta{color:var(--muted);font-size:.9rem;margin:.1rem 0 .4rem;}
			.rsm ul{margin:.3rem 0 0;padding-left:1.1rem;display:flex;flex-direction:column;gap:.35rem;}
			/* Hero photo */
			.hero-photo{flex:none;width:210px;height:210px;border-radius:50%;object-fit:cover;object-position:center;border:3px solid color-mix(in srgb, var(--accent-2) 55%, var(--border));box-shadow:var(--shadow), 0 0 40px -8px color-mix(in srgb, var(--accent-2) 45%, transparent);display:block;}
			/* Education */
			.edu-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1.1rem;}
			.edu-item{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
			.edu-school{margin:0;font-size:1.1rem;font-weight:700;}
			.edu-degree{margin:.15rem 0 0;color:var(--accent);font-weight:600;font-size:.98rem;}
			.edu-note{margin:.2rem 0 0;color:var(--muted);font-size:.9rem;}
			.edu-period{color:var(--muted);font-size:.9rem;white-space:nowrap;font-variant-numeric:tabular-nums;}
			/* Hero layout */
			.hero-top{display:flex;align-items:center;gap:2.5rem;flex-wrap:wrap;}
			.hero-text{flex:1 1 320px;min-width:0;}
			.exp-item{scroll-margin-top:84px;}
			@media (max-width:640px){.hero-photo{width:150px;height:150px;}}
			/* Social / brand buttons */
			.btn-social{display:inline-flex;align-items:center;gap:.5rem;}
			.btn-ico{flex:none;}
			.btn-linkedin{background:#0A66C2;border-color:#0A66C2;color:#fff;}
			.btn-linkedin:hover{border-color:#0A66C2;filter:brightness(1.1);}
			.btn-github{background:#1f2328;border-color:#3a4048;color:#fff;}
			.btn-github:hover{border-color:#8b949e;filter:brightness(1.15);}
			.btn-email{background:var(--accent);border-color:var(--accent);color:var(--accent-fg);}
			.btn-email:hover{filter:brightness(1.08);}
			.contact-actions{display:flex;flex-wrap:wrap;gap:.75rem;}
			/* Project carousel */
			.proj-carousel{position:relative;margin:-0.2rem 0 1rem;}
			.proj-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;border-radius:10px;}
			.proj-track::-webkit-scrollbar{display:none;}
			.proj-slide{flex:0 0 100%;scroll-snap-align:center;margin:0;}
			.proj-slide img{width:100%;height:auto;display:block;border-radius:10px;border:1px solid var(--border);background:var(--surface-2);}
			.proj-slide figcaption{margin-top:.4rem;font-size:.78rem;color:var(--muted);text-align:center;}
			.proj-arrow{position:absolute;top:44%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;border:1px solid var(--border);background:color-mix(in srgb, var(--surface) 78%, transparent);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;line-height:1;backdrop-filter:blur(4px);transition:border-color .15s ease;}
			.proj-arrow:hover{border-color:var(--accent);}
			.proj-prev{left:6px;}
			.proj-next{right:6px;}
			.proj-dots{display:flex;justify-content:center;gap:6px;margin-top:.55rem;}
			.proj-dot{width:7px;height:7px;border-radius:50%;border:none;padding:0;background:color-mix(in srgb, var(--fg) 28%, transparent);cursor:pointer;}
			.proj-dot.active{background:var(--accent);}
		</style>
	</body>
</html>
