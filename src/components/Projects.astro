---
import { projects } from "../data/resume";
---

<div class="proj-grid">
	{
		projects.map((p) => (
			<article class="proj-card">
				{p.screens && p.screens.length > 0 ? (
					<div class="proj-carousel">
						<div class="proj-track">
							{p.screens.map((s) => (
								<figure class="proj-slide">
									<img src={s.src} alt={s.caption ?? `${p.name} screenshot`} loading="lazy" />
									{s.caption && <figcaption>{s.caption}</figcaption>}
								</figure>
							))}
						</div>
						{p.screens.length > 1 && (
							<Fragment>
								<button class="proj-arrow proj-prev" type="button" aria-label="Previous screenshot">‹</button>
								<button class="proj-arrow proj-next" type="button" aria-label="Next screenshot">›</button>
								<div class="proj-dots">
									{p.screens.map((_, i) => (
										<button class="proj-dot" type="button" aria-label={`Go to screenshot ${i + 1}`} />
									))}
								</div>
							</Fragment>
						)}
					</div>
				) : p.shot ? (
					<a
						class="proj-shot"
						href={p.href}
						target={p.href ? "_blank" : undefined}
						rel={p.href ? "noopener" : undefined}
						tabindex={p.href ? undefined : -1}
						aria-hidden={p.href ? undefined : "true"}
					>
						<img src={p.shot} alt={`${p.name} screenshot`} loading="lazy" />
					</a>
				) : null}
				<div class="proj-card-head">
					<h3 class="proj-name">{p.name}</h3>
					<span class="proj-year">{p.period}</span>
				</div>
				<p class="proj-blurb">{p.blurb}</p>
				<ul class="proj-tags">
					{p.tags.map((t) => (
						<li>{t}</li>
					))}
				</ul>
				{(p.href || p.diagram) && (
					<div class="proj-links">
						{p.href && (
							<a href={p.href} target="_blank" rel="noopener">
								View code →
							</a>
						)}
						{p.diagram && (
							<a href={p.diagram} target="_blank" rel="noopener">
								Architecture →
							</a>
						)}
					</div>
				)}
			</article>
		))
	}
</div>

<script>
	document.querySelectorAll<HTMLElement>(".proj-carousel").forEach((c) => {
		const track = c.querySelector<HTMLElement>(".proj-track");
		const slides = c.querySelectorAll(".proj-slide");
		const dots = Array.from(c.querySelectorAll<HTMLElement>(".proj-dot"));
		if (!track || slides.length < 2) return;
		const cur = () => Math.round(track.scrollLeft / track.clientWidth);
		const go = (i: number) =>
			track.scrollTo({ left: Math.max(0, Math.min(slides.length - 1, i)) * track.clientWidth, behavior: "smooth" });
		c.querySelector(".proj-prev")?.addEventListener("click", () => go(cur() - 1));
		c.querySelector(".proj-next")?.addEventListener("click", () => go(cur() + 1));
		dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
		const update = () => dots.forEach((d, k) => d.classList.toggle("active", k === cur()));
		track.addEventListener("scroll", () => requestAnimationFrame(update));
		update();
	});
</script>
