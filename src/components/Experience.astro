---
import { experience } from "../data/resume";
---

<ul class="exp-list">
	{
		experience.map((role) => (
			<li class="exp-item">
				<div class="exp-head">
					<div>
						<h3 class="exp-title">{role.title}</h3>
						<p class="exp-company">
							{role.company}
							{role.location ? ` · ${role.location}` : ""}
						</p>
					</div>
					<span class="exp-period">{role.period}</span>
				</div>
				<ul class="exp-bullets">
					{role.highlights.map((h) => (
						<li>{h}</li>
					))}
				</ul>
			</li>
		))
	}
</ul>
