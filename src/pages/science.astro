---
// Science view — the career written up as a short research paper.
import View from "../layouts/View.astro";
import { paper } from "../data/views";
import { profile, projects, experience, patents } from "../data/resume";

const title = `${profile.name} — Science`;
const description =
  "Brandon V. Taylor for scientists: AI evaluation with LLM-as-a-judge, latency as a causal lever, tracing at scale and signal processing.";
const topics = [...new Set(patents.map((p) => p.topic))];
const usNumber = (n: string) => `US ${Number(n).toLocaleString("en-US")}`;
const issuedOn = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
const ferry = projects.find((p) => p.name === "Ferry Tracker")!;
const turntable = projects.find((p) => p.name === "Turntable Speed")!;
const skype = experience.find((r) => r.id === "skype")!;
---

<View
  title={title}
  description={description}
  view="science"
  fonts="family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&family=IBM+Plex+Mono"
>
  <main class="sci">
    <article class="paper">
      <header class="masthead">
        <span class="mono">brandonvtaylor.com/science</span>
        <h1>{paper.title}</h1>
        <p class="author">{profile.name}<sup>1</sup></p>
        <p class="affil"><sup>1</sup>{paper.affiliation}</p>
      </header>

      <section class="abstract">
        <h2>Abstract</h2>
        <p set:html={paper.abstract} />
        <p class="keywords"><strong>Keywords:</strong> {paper.keywords}</p>
      </section>

      <div class="cols">
        <h2>1&nbsp; AI evaluation at scale</h2>
        <p>
          Generative AI is now used across the software lifecycle (plan, design,
          code, test) by teams building on amazon.com. Two questions follow:
          <em>what should the model do</em>, and <em>how do we know it did it</em>?
          One of my teams encodes expert engineering standards for the first.
          The second is answered by an evaluation platform that scores agents,
          hooks and skills as teams iterate on them.
        </p>
        <figure>
          <div class="pipeline" role="img" aria-label="Agent output flows to deterministic validators and an LLM judge, then to scoring, baselining and comparison">
            <span>agent output</span><b aria-hidden="true">→</b>
            <span class="stack"><span>deterministic validators</span><span class="blue">LLM-as-a-judge</span></span><b aria-hidden="true">→</b>
            <span>score · baseline · compare</span>
          </div>
          <figcaption><strong>Figure 1.</strong> Evaluation pipeline. Cheap, exact checks run first; judged rubrics cover what rules cannot.</figcaption>
        </figure>

        <h2>2&nbsp; Latency as a causal lever</h2>
        <p>
          We treated latency as a product: instrument the critical path, target
          the slowest <em>real</em> customer experiences rather than averages,
          and prove the revenue impact of every millisecond.
        </p>
        <figure>
          <div class="bars" role="img" aria-label="Shopping latency indexed: 100 before, about 60 after">
            <div><span>before</span><i style="width: 80%"></i><span>100</span></div>
            <div><span>after</span><i class="blue" style="width: 48%"></i><span>~60</span></div>
          </div>
          <figcaption><strong>Figure 2.</strong> amazon.com shopping latency, indexed. A ~40% reduction, the fastest in years; estimated $1.5B+ annual revenue.</figcaption>
        </figure>

        <h2>3&nbsp; Seeing the whole request</h2>
        <p>
          Distributed tracing and analytics across a 90,000+ service graph let
          any team see how one customer request actually flows. A related effort
          applied custom AI to turn slow, manual migration programs into
          automated, repeatable workflows.
        </p>

        <h2>4&nbsp; Small models, honestly built</h2>
        <p>
          <em>{turntable.name}</em> measures true RPM and wow-and-flutter from a
          phone camera: the label's rotation is tracked frame to frame by phase
          correlation, and an FFT over the speed series isolates periodic error.
          No test record or strobe disc is needed; the DSP core is
          dependency-free and unit-tested.
        </p>
        <figure class="shots">
          <div>
            {turntable.screens?.map((s) => <img src={s.src} alt={s.caption} loading="lazy" />)}
          </div>
          <figcaption><strong>Figure 3.</strong> {turntable.name}: live reading and calibration result.</figcaption>
        </figure>
        <p>
          <em>{ferry.name}</em> personalizes “leave by” times with a trimmed
          mean over a rider's own recorded crossings, so one unusual crossing
          does not skew the estimate.
        </p>
        <p>
          Earlier, <em>bSeattle</em> (Bing Mobile) used ML-generated dish
          summaries to answer “what should I order?” and held a 4.5★ lifetime
          rating.
        </p>

        <h2>5&nbsp; Leading science teams</h2>
        <p>
          My org includes a growing applied-science team. One question I asked
          a direct report, “why not make use of our historical data?”, became a
          significant initiative. Asked to size a new business in
          package-delivery latency, I gave the analysis to our economist and
          TPM, and we delivered a recommendation in a month.
        </p>
      </div>

      <section class="patents" id="patents">
        <h2>6&nbsp; Patents</h2>
        <p class="patents-lede">
          {patents.length} issued U.S. patents, {patents.at(-1)!.issued.slice(0, 4)}–{patents[0].issued.slice(0, 4)}:
          from document metadata in Office, to call delegation and AR calling, to
          voice announcements and messaging on Alexa.
        </p>
        {
          topics.map((topic) => (
            <div class="patent-group">
              <h3>{topic}</h3>
              <ul>
                {patents
                  .filter((p) => p.topic === topic)
                  .map((p) => (
                    <li>
                      <span class="patent-title">{p.title}</span>
                      <span class="patent-meta">
                        <a href={`https://patents.google.com/patent/US${p.number}`} target="_blank" rel="noopener">
                          {usNumber(p.number)}
                        </a>{" "}
                        · issued {issuedOn(p.issued)}
                      </span>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="refs">
        <h2>References</h2>
        <ol>
          <li>
            Skype on HoloLens: AR video calling used aboard the International
            Space Station. <a href={`https://www.youtube.com/watch?v=${skype.video}`}>Video</a>.
          </li>
          {
            ferry.diagram && (
              <li>
                {ferry.name} system architecture. <a href={ferry.diagram}>github.com/rufbulldog/ferry-tracker</a>.
              </li>
            )
          }
          <li>Full résumé. <a href="/resume">brandonvtaylor.com/resume</a>.</li>
        </ol>
      </section>
    </article>
  </main>
</View>

<style is:global>
  body[data-view="science"] {
    --view-bg: #e7e9ee;
    --view-fg: #1d2330;
    --view-muted: #4a5262;
    --view-line: #d4d8e0;
    --view-accent: #2849a8;
    --view-active-bg: #1d2330;
    --view-active-fg: #fff;
    --view-ui-font: Inter, system-ui, sans-serif;
    --view-brand-font: "Source Serif 4", serif;
  }
</style>

<style>
  .sci {
    padding: 1.5rem 1rem 4rem;
  }
  .paper {
    max-width: 62rem;
    margin: 0 auto;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 12px 32px rgba(29, 35, 48, 0.08);
    padding: 4rem clamp(1.25rem, 6vw, 5rem);
    font-family: "Source Serif 4", Georgia, serif;
    color: #1d2330;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .paper a {
    color: #2849a8;
  }
  .mono {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    color: #4a5262;
  }
  .masthead {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  h1 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1.2;
  }
  .author {
    margin: 0;
    font-size: 1.125rem;
  }
  .affil {
    margin: 0;
    font-size: 14px;
    color: #4a5262;
    font-style: italic;
  }
  .abstract {
    max-width: 45rem;
    margin: 0 auto;
  }
  .abstract h2,
  .refs h2 {
    margin: 0 0 0.5rem;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }
  .refs h2 {
    text-align: left;
  }
  .abstract p {
    margin: 0 0 0.5rem;
    line-height: 1.65;
    text-align: justify;
    hyphens: auto;
  }
  .keywords {
    font-size: 14px;
    color: #4a5262;
  }
  .cols {
    column-count: 2;
    column-gap: 2.5rem;
    font-size: 16px;
    line-height: 1.65;
    text-align: justify;
    hyphens: auto;
  }
  @media (max-width: 820px) {
    .cols {
      column-count: 1;
    }
  }
  .cols h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    break-after: avoid;
    text-align: left;
  }
  .cols p {
    margin: 0 0 0.9rem;
  }
  .cols figure {
    margin: 0 0 1rem;
    border: 1px solid #d4d8e0;
    padding: 0.9rem;
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  figcaption {
    font-size: 13px;
    color: #4a5262;
    text-align: left;
  }
  .pipeline {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-family: Inter, sans-serif;
    font-size: 12px;
    text-align: center;
  }
  .pipeline span:not(.stack) {
    border: 1px solid #1d2330;
    padding: 6px 8px;
  }
  .pipeline .stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pipeline .blue {
    border-color: #2849a8 !important;
    color: #2849a8;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: Inter, sans-serif;
    font-size: 12px;
  }
  .bars div {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bars span:first-child {
    width: 3.5rem;
  }
  .bars i {
    height: 18px;
    background: #9aa3b5;
  }
  .bars i.blue {
    background: #2849a8;
  }
  .shots div {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }
  .shots img {
    width: 45%;
    border-radius: 14px;
    border: 1px solid #d4d8e0;
  }
  .patents {
    border-top: 1px solid #d4d8e0;
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .patents h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .patents-lede {
    margin: 0;
    line-height: 1.6;
  }
  .patent-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .patent-group h3 {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2849a8;
  }
  .patent-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 2rem;
  }
  @media (max-width: 720px) {
    .patent-group ul {
      grid-template-columns: 1fr;
    }
  }
  .patent-group li {
    display: flex;
    flex-direction: column;
    font-size: 15px;
    line-height: 1.45;
  }
  .patent-meta {
    font-family: Inter, sans-serif;
    font-size: 12px;
    color: #4a5262;
  }
  .refs {
    border-top: 1px solid #d4d8e0;
    padding-top: 1.1rem;
    font-size: 14px;
    line-height: 1.6;
  }
  .refs ol {
    margin: 0;
    padding-left: 1.5rem;
  }
</style>
